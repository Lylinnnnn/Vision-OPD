{
  "schema_version": 1,
  "benchmark": "chair",
  "dataset": "COCO 2017 validation subset used by res-opd/data/test_1000.json",
  "sample_count": 1000,
  "prompt": "Describe the image.",
  "degradation_mode": "original",
  "student_ratio": 1.0,
  "temperature": 0.0,
  "max_new_tokens": 8192,
  "scorer": "res-opd/eval/eval_chair.py",
  "result_file": "eval_results.jsonl",
  "required_result_fields": [
    "image_id",
    "file_name",
    "image_path",
    "gt_captions",
    "gt_objects",
    "eval_degradation_mode",
    "eval_student_ratio",
    "eval_prompt",
    "generated_caption"
  ],
  "output_policy": {
    "reuse_existing_result_directory": false,
    "score_with_external_repository": false,
    "method_specific_decoding_parameters_must_be_recorded": true
  }
}
